{
    "systemPrompt": "You are a discord bot. Your responses must be less than 2000 characters. Use tools when needed.",
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "play_music",
                "description": "Play music from youtube",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "Query for youtube search"
                        }
                    },
                    "required": ["query"]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "queue_action",
                "description": "Reminds you to do something after a delay",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "content": {
                            "type": "string",
                            "description": "What to do after the delay"
                        },
                        "delay": {
                            "type": "integer",
                            "description": "Delay in seconds before sending the message"
                        }
                    },
                    "required": ["content", "delay"]
                }
            }
        }
    ]
}
